---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import T from "./T.astro";
const base = import.meta.env.BASE_URL;

const faqs = [
  { qEs: "¿De verdad es gratis? ¿Cuál es el truco?", qEn: "Is it really free? What's the catch?", aEs: "Sí, completamente gratis y sin truco. No hay versión 'Pro', ni suscripción, ni funciones bloqueadas. Es un proyecto de código abierto para educadores, creadores y equipos que presentan a diario.", aEn: "Yes, completely free and no catch. There's no 'Pro' version, no subscription, no locked features. It's an open-source project for educators, creators and teams who present every day." },
  { qEs: "¿En qué sistemas funciona?", qEn: "Which systems does it run on?", aEs: "<strong class='text-ink'>Windows 10/11</strong>, <strong class='text-ink'>macOS</strong> (en la Mac App Store) y <strong class='text-ink'>Android 8.0 o superior</strong> (en Google Play) ya están disponibles. Para <strong class='text-ink'>Linux</strong> hay una descarga self-contained sobre X11: el overlay y el dibujo funcionan, la captura sigue siendo experimental.", aEn: "<strong class='text-ink'>Windows 10/11</strong>, <strong class='text-ink'>macOS</strong> (on the Mac App Store) and <strong class='text-ink'>Android 8.0 or later</strong> (on Google Play) are available. For <strong class='text-ink'>Linux</strong> there's a self-contained X11 download: the overlay and drawing work, capture is still experimental." },
  { qEs: "¿La versión de Android hace lo mismo que la de escritorio?", qEn: "Does the Android version do the same as the desktop one?", aEs: "Casi todo: lápiz, marcador, láser, líneas, flechas, rectángulos, elipses, texto, borrador, selección, pizarra, deshacer/rehacer y captura que se guarda en tu galería — con la barra flotando sobre cualquier app. Puedes dejar que los toques pasen a la app de abajo y arrancarla desde el mosaico de Ajustes rápidos. Lo que aún no está en el móvil: <em>spotlight</em>, lupa y freeze.", aEn: "Almost everything: pen, highlighter, laser, lines, arrows, rectangles, ellipses, text, eraser, selection, whiteboard, undo/redo and a capture that saves to your gallery — with the toolbar floating over any app. You can let taps pass through to the app underneath and start it from the Quick Settings tile. Not on mobile yet: <em>spotlight</em>, magnifier and freeze." },
  { qEs: "¿Qué permisos pide en Android y por qué?", qEn: "What permissions does it ask for on Android, and why?", aEs: `Tres: <strong class='text-ink'>mostrar sobre otras apps</strong>, para pintar la capa de anotación encima; una <strong class='text-ink'>notificación</strong> mientras el overlay está activo, que es lo que Android exige a los servicios en primer plano; y la <strong class='text-ink'>captura de pantalla</strong>, que se activa solo cuando pulsas el botón de cámara. No hay cuentas, anuncios ni analítica, y nada sale de tu teléfono. Todo el detalle en la <a href='${base}privacy' class='text-amber underline underline-offset-2'>política de privacidad</a>.`, aEn: `Three: <strong class='text-ink'>display over other apps</strong>, to paint the annotation layer on top; a <strong class='text-ink'>notification</strong> while the overlay is running, which is what Android requires of foreground services; and <strong class='text-ink'>screen capture</strong>, which only kicks in when you tap the camera button. There are no accounts, ads or analytics, and nothing leaves your phone. Full detail in the <a href='${base}privacy' class='text-amber underline underline-offset-2'>privacy policy</a>.` },
  { qEs: "¿Mis capturas llevan marca de agua?", qEn: "Do my captures have a watermark?", aEs: "Nunca. Las capturas PNG salen limpias, exactamente como ves la pantalla con tus anotaciones. Puedes guardarlas o copiarlas al portapapeles.", aEn: "Never. PNG captures come out clean, exactly as you see the screen with your annotations. You can save them or copy them to the clipboard." },
  { qEs: "¿Interfiere con mi trabajo cuando no dibujo?", qEn: "Does it interfere when I'm not drawing?", aEs: "No. En reposo el overlay es <em>click-through</em>: el ratón pasa a través como si la app no existiera. Solo al activar el modo dibujo la pantalla se vuelve un lienzo.", aEn: "No. At rest the overlay is <em>click-through</em>: the mouse passes through as if the app didn't exist. Only when you turn on drawing mode does the screen become a canvas." },
  { qEs: "¿Funciona con varios monitores y pantallas 4K?", qEn: "Does it work with multiple monitors and 4K?", aEs: "Sí, en escritorio. Un overlay por pantalla con historial y deshacer compartidos, y soporte per-monitor DPI para que los trazos se vean nítidos en HiDPI / 4K.", aEn: "Yes, on desktop. One overlay per screen with shared history and undo, plus per-monitor DPI so strokes look crisp on HiDPI / 4K." },
  { qEs: "¿Puedo cambiar los atajos de teclado?", qEn: "Can I change the keyboard shortcuts?", aEs: "Sí, en escritorio: todos los atajos globales son reasignables desde Ajustes → Teclas de acceso rápido, y se guardan en tu perfil. Pensado para teclados en español / LATAM. En Android todo se maneja desde la barra flotante.", aEn: "Yes, on desktop: all global shortcuts are reassignable from Settings → Keyboard shortcuts, and they're saved to your profile. Designed for Spanish / LATAM keyboards. On Android everything is handled from the floating toolbar." },
  { qEs: "¿Puedo usarlo en clases o en mi empresa?", qEn: "Can I use it in classes or at my company?", aEs: "Por supuesto. Uso personal, educativo y comercial, sin restricciones ni licencias que comprar.", aEn: "Absolutely. Personal, educational and commercial use, with no restrictions or licenses to buy." },
];
---
<section id="faq" class="cv-auto mx-auto max-w-3xl px-5 py-24">
  <SectionHead
    eyebrowEs="Preguntas frecuentes" eyebrowEn="FAQ"
    titleEs="Lo que la gente <span class='grad-text'>suele preguntar</span>"
    titleEn="What people <span class='grad-text'>usually ask</span>"
  />

  <div class="reveal mt-12 divide-y divide-white/8 overflow-hidden rounded-2xl border border-white/8 bg-white/[0.02]">
    {faqs.map((f) => (
      <details class="group px-6">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium marker:hidden">
          <span><T es={f.qEs} en={f.qEn} /></span>
          <span class="grid size-6 shrink-0 place-items-center rounded-full border border-white/15 text-ink-dim transition group-open:rotate-45">
            <Icon name="plus" class="size-3.5 [stroke-width:2.5]" />
          </span>
        </summary>
        <p class="-mt-1 pb-5 pr-10 text-sm leading-relaxed text-ink-soft">
          <T es={f.aEs} en={f.aEn} />
        </p>
      </details>
    ))}
  </div>
</section>
