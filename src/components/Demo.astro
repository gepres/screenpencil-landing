---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import T from "./T.astro";

// Paleta rápida de la toolbar (los 6 colores de la app).
const colors = [
  { c: "#e0a060", n: "Ámbar" },
  { c: "#22d3ee", n: "Cian" },
  { c: "#3b82f6", n: "Azul" },
  { c: "#ef4444", n: "Rojo" },
  { c: "#22c55e", n: "Verde" },
  { c: "#f8fafc", n: "Blanco" },
];

// Orden de la barra vertical de la app real (docs/10-ui-ux-spec.md del repo de la app):
// lápiz, marcador, línea, flecha, rectángulo, elipse, texto, borrador.
// `live` = implementada en esta demo; el resto abre el aviso de descarga.
const tools = [
  { id: "pen", icon: "tool-pen" as const, es: "Lápiz", en: "Pen", live: true },
  { id: "marker", icon: "tool-highlighter" as const, es: "Marcador", en: "Highlighter", live: true },
  { id: "line", icon: "tool-line" as const, es: "Línea", en: "Line", live: false },
  { id: "arrow", icon: "tool-arrow" as const, es: "Flecha", en: "Arrow", live: false },
  { id: "rect", icon: "tool-rect" as const, es: "Rectángulo", en: "Rectangle", live: false },
  { id: "ellipse", icon: "tool-ellipse" as const, es: "Elipse", en: "Ellipse", live: false },
  { id: "text", icon: "tool-text" as const, es: "Texto", en: "Text", live: false },
  { id: "eraser", icon: "tool-eraser" as const, es: "Borrador", en: "Eraser", live: true },
];

const btn =
  "grid size-7 shrink-0 place-items-center rounded-lg text-ink-soft transition hover:bg-white/10 hover:text-ink";
const btnLive = " aria-pressed:bg-amber/20 aria-pressed:text-amber";
const btnLocked = " opacity-45 hover:opacity-100";
---
<section id="demo" class="mx-auto max-w-5xl px-5 py-24">
  <SectionHead
    eyebrowEs="Pruébalo aquí mismo" eyebrowEn="Try it right here"
    titleEs="Dibuja en esta <span class='grad-text'>mini pizarra</span>"
    titleEn="Draw on this <span class='grad-text'>mini whiteboard</span>"
    subEs="La barra lateral es la misma de la app. Aquí funcionan el lápiz, el marcador y el borrador — el resto trabaja sobre toda tu pantalla, en la app de verdad."
    subEn="The side toolbar is the one from the app. Pen, highlighter and eraser work right here — the rest works over your entire screen, in the real app."
  />

  <div data-demo-wrap class="reveal relative mt-12 overflow-hidden rounded-2xl border border-white/10 bg-[#0d1018]">
    <canvas data-demo-canvas class="block h-[560px] w-full touch-none sm:h-[600px]" aria-label="Lienzo de dibujo"></canvas>

    <!-- Toolbar flotante vertical: como en la app, anclada a la izquierda y movible por el asa. -->
    <div
      data-demo-toolbar
      role="toolbar"
      aria-label="Herramientas de la demo"
      class="absolute left-4 top-1/2 flex max-h-[calc(100%-1rem)] -translate-y-1/2 flex-col items-center gap-0.5 overflow-y-auto rounded-2xl border border-white/12 bg-bg-0/85 p-1 shadow-[0_8px_30px_rgba(0,0,0,0.45)] backdrop-blur-md [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <span
        data-demo-grip
        class="grid h-5 w-7 shrink-0 cursor-grab touch-none place-items-center text-ink-dim active:cursor-grabbing"
        title="Mover la barra"
      >
        <Icon name="menu" class="size-4 [stroke-width:1.8]" />
      </span>

      <span class="h-px w-5 bg-white/10"></span>

      {tools.map((t, i) => (
        <button
          data-tool={t.id}
          data-live={t.live ? "" : undefined}
          data-locked={t.live ? undefined : ""}
          data-name-es={t.es}
          data-name-en={t.en}
          class={btn + (t.live ? btnLive : btnLocked)}
          aria-pressed={i === 0 ? "true" : "false"}
          title={t.es}
        >
          <Icon name={t.icon} class="size-[18px] [stroke-width:1.8]" />
        </button>
      ))}

      <span class="h-px w-5 bg-white/10"></span>

      <!-- Paleta 2×3, como en la app -->
      <div class="grid grid-cols-2 gap-1 py-0.5">
        {colors.map((s, i) => (
          <button
            data-color={s.c}
            class="size-[22px] rounded-full ring-2 ring-transparent transition aria-pressed:ring-white/90"
            style={`background:${s.c}`}
            aria-pressed={i === 0 ? "true" : "false"}
            title={s.n}
          ></button>
        ))}
      </div>

      <span class="h-px w-5 bg-white/10"></span>

      <!-- Grosor: slider vertical + valor, como en la app -->
      <input
        type="range" min="2" max="28" value="6" data-demo-size
        class="h-14 w-7 cursor-pointer accent-amber [direction:rtl] [writing-mode:vertical-lr]"
        title="Grosor"
        aria-label="Grosor"
      />
      <span data-demo-size-val class="font-mono text-[10px] leading-none text-ink-dim">6</span>

      <span class="h-px w-5 bg-white/10"></span>

      <div class="flex gap-0.5">
        <button data-locked data-name-es="Deshacer" data-name-en="Undo" class={btn + btnLocked} title="Deshacer">
          <Icon name="tool-undo" class="size-[18px] [stroke-width:1.8]" />
        </button>
        <button data-locked data-name-es="Rehacer" data-name-en="Redo" class={btn + btnLocked} title="Rehacer">
          <Icon name="tool-redo" class="size-[18px] [stroke-width:1.8]" />
        </button>
      </div>

      <button data-demo-clear class={btn} title="Limpiar">
        <Icon name="tool-trash" class="size-[18px] [stroke-width:1.7]" />
      </button>

      <button
        data-locked
        data-name-es="Salir del modo dibujo"
        data-name-en="Exit drawing mode"
        class={btn + btnLocked}
        title="Salir del modo dibujo"
      >
        <Icon name="tool-close" class="size-[18px] [stroke-width:1.9]" />
      </button>
    </div>

    <!-- Aviso sobre la pizarra cuando se pulsa una herramienta que solo existe en la app -->
    <div
      data-demo-note
      class="pointer-events-none absolute inset-x-4 bottom-4 flex justify-center opacity-0 transition-all duration-300 data-[show]:opacity-100"
    >
      <div class="pointer-events-auto flex max-w-md flex-wrap items-center justify-center gap-x-3 gap-y-2 rounded-xl border border-amber/30 bg-bg-0/92 px-4 py-3 text-center shadow-[0_8px_30px_rgba(0,0,0,0.45)] backdrop-blur">
        <span data-demo-note-text class="text-sm text-ink-soft"></span>
        <a
          href="#download"
          class="inline-flex items-center gap-1.5 rounded-full bg-amber px-3.5 py-1.5 text-xs font-semibold text-bg-0 transition hover:bg-amber/90"
        >
          <Icon name="download" class="size-3.5" />
          <T es="Descargar gratis" en="Download free" />
        </a>
      </div>
    </div>
  </div>

  <p class="reveal mt-4 text-center text-sm text-ink-dim">
    <T
      es="✦ Mantén pulsado y arrastra para dibujar · la barra se mueve desde el asa de arriba"
      en="✦ Press and drag to draw · move the toolbar from the grip at the top"
    />
  </p>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-demo-wrap]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-demo-canvas]");
  const toolbar = document.querySelector<HTMLElement>("[data-demo-toolbar]");

  if (wrap && canvas && toolbar) {
    const ctx = canvas.getContext("2d")!;
    let tool: "pen" | "marker" | "eraser" = "pen";
    let color = "#e0a060";
    let size = 6;
    let drawing = false;
    let last: { x: number; y: number } | null = null;
    let used = false;

    const track = (path: string, title: string) => {
      try {
        (window as any).goatcounter?.count({ path, title, event: true });
      } catch {
        /* noop */
      }
    };

    /* ---------- Lienzo ---------- */
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas!.getBoundingClientRect();
      // Preserva el dibujo al redimensionar
      const prev = ctx.getImageData ? canvas!.toDataURL() : null;
      canvas!.width = Math.round(rect.width * dpr);
      canvas!.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      if (prev) {
        const img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0, rect.width, rect.height);
        img.src = prev;
      }
    }
    resize();
    let rt: number | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(resize, 150);
    });

    function pos(e: PointerEvent) {
      const r = canvas!.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    function start(e: PointerEvent) {
      drawing = true;
      last = pos(e);
      canvas!.setPointerCapture(e.pointerId);
      hideNote();
      if (!used) {
        used = true;
        track("demo/used", "Demo: primer trazo");
      }
    }
    function move(e: PointerEvent) {
      if (!drawing || !last) return;
      const p = pos(e);
      ctx.globalCompositeOperation = tool === "eraser" ? "destination-out" : "source-over";
      ctx.strokeStyle = color;
      ctx.lineWidth = tool === "marker" ? size * 2.2 : tool === "eraser" ? size * 2.6 : size;
      ctx.globalAlpha = tool === "marker" ? 0.35 : 1;
      ctx.beginPath();
      ctx.moveTo(last.x, last.y);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
      last = p;
    }
    function end() {
      drawing = false;
      last = null;
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
    }

    canvas.addEventListener("pointerdown", start);
    canvas.addEventListener("pointermove", move);
    canvas.addEventListener("pointerup", end);
    canvas.addEventListener("pointerleave", end);

    /* ---------- Aviso: esa herramienta solo existe en la app ---------- */
    const note = wrap.querySelector<HTMLElement>("[data-demo-note]");
    const noteText = wrap.querySelector<HTMLElement>("[data-demo-note-text]");
    let noteTimer: number | undefined;

    const isEn = () => document.documentElement.getAttribute("data-lang") === "en";

    function hideNote() {
      note?.removeAttribute("data-show");
      clearTimeout(noteTimer);
    }
    function showNote(btn: HTMLElement) {
      if (!note || !noteText) return;
      const name = (isEn() ? btn.dataset.nameEn : btn.dataset.nameEs) || "";
      noteText.textContent = isEn()
        ? `“${name}” only works in the real app. Better download ScreenPencil — it is free.`
        : `«${name}» solo funciona en la app de verdad. Mejor descárgate ScreenPencil: es gratis.`;
      note.setAttribute("data-show", "");
      clearTimeout(noteTimer);
      noteTimer = window.setTimeout(hideNote, 6000);
      track("demo/locked/" + (btn.dataset.tool || name), "Demo: herramienta solo en la app");
    }

    /* ---------- Herramientas ---------- */
    toolbar
      .querySelectorAll<HTMLButtonElement>("[data-locked]")
      .forEach((b) => b.addEventListener("click", () => showNote(b)));

    toolbar.querySelectorAll<HTMLButtonElement>("[data-tool][data-live]").forEach((b) =>
      b.addEventListener("click", () => {
        tool = b.dataset.tool as typeof tool;
        toolbar.querySelectorAll("[data-tool]").forEach((x) => x.setAttribute("aria-pressed", "false"));
        b.setAttribute("aria-pressed", "true");
        hideNote();
      }),
    );

    toolbar.querySelectorAll<HTMLButtonElement>("[data-color]").forEach((b) =>
      b.addEventListener("click", () => {
        color = b.dataset.color!;
        if (tool === "eraser") {
          tool = "pen";
          toolbar
            .querySelectorAll("[data-tool]")
            .forEach((x) => x.setAttribute("aria-pressed", String(x.getAttribute("data-tool") === "pen")));
        }
        toolbar.querySelectorAll("[data-color]").forEach((x) => x.setAttribute("aria-pressed", "false"));
        b.setAttribute("aria-pressed", "true");
      }),
    );

    const sizeVal = toolbar.querySelector<HTMLElement>("[data-demo-size-val]");
    toolbar.querySelector<HTMLInputElement>("[data-demo-size]")?.addEventListener("input", (e) => {
      size = Number((e.target as HTMLInputElement).value);
      if (sizeVal) sizeVal.textContent = String(size);
    });

    toolbar.querySelector("[data-demo-clear]")?.addEventListener("click", () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hideNote();
    });

    /* ---------- Arrastrar la barra por el asa (como la toolbar real) ---------- */
    const grip = toolbar.querySelector<HTMLElement>("[data-demo-grip]");
    if (grip) {
      let dragging = false;
      let offX = 0;
      let offY = 0;
      grip.addEventListener("pointerdown", (e) => {
        const wr = wrap.getBoundingClientRect();
        const br = toolbar.getBoundingClientRect();
        offX = e.clientX - br.left;
        offY = e.clientY - br.top;
        // Suelta el centrado por CSS y pasa a coordenadas absolutas dentro del lienzo.
        // Tailwind v4 centra con la propiedad `translate`, no con `transform`: hay que anular ambas.
        toolbar.style.translate = "none";
        toolbar.style.transform = "none";
        toolbar.style.left = `${br.left - wr.left}px`;
        toolbar.style.top = `${br.top - wr.top}px`;
        dragging = true;
        grip.setPointerCapture(e.pointerId);
        e.preventDefault();
      });
      grip.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const wr = wrap.getBoundingClientRect();
        const br = toolbar.getBoundingClientRect();
        const x = Math.min(Math.max(e.clientX - wr.left - offX, 8), wr.width - br.width - 8);
        const y = Math.min(Math.max(e.clientY - wr.top - offY, 8), wr.height - br.height - 8);
        toolbar.style.left = `${x}px`;
        toolbar.style.top = `${y}px`;
      });
      const stopDrag = () => (dragging = false);
      grip.addEventListener("pointerup", stopDrag);
      grip.addEventListener("pointercancel", stopDrag);
    }
  }
</script>
